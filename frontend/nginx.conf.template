# Serve the built React app and proxy /api/* to the backend.
# This is a template: on startup the container renders it with `envsubst`,
# injecting $BACKEND_URL (the backend base URL) and $PORT (the listener port).
# nginx's own variables ($host, $uri, ...) are preserved because envsubst only
# substitutes ${BACKEND_URL} and ${PORT}.
server {
    listen ${PORT};

    root /usr/share/nginx/html;
    index index.html;

    # API proxy → FastAPI backend (SSE streaming support)
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Required for the /optimize/run/stream SSE endpoint
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # SPA routing — let React Router handle client-side routes
    location / {
        try_files $uri $uri/ /index.html;
    }
}
